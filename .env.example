# PostgreSQL connection string (required)
DATABASE_URL=
# Redis URL (optional — leave blank for fast built-in in-memory cache)
REDIS_URL=

# Server port
DYNAGO_PORT=8080

# Cache TTL (Go duration: 5m, 30s, 1h)
DYNAGO_CACHE_TTL=5m

# Directory containing .wasm plugin files
DYNAGO_PLUGIN_DIR=./plugins

# JWT secret for auth middleware (leave empty to disable auth)
DYNAGO_JWT_SECRET=supersecretjwtkey12345

# Authentication credentials for /api/v1/_auth/login
DYNAGO_AUTH_USER=admin
DYNAGO_AUTH_PASS=dynago123

# Token expiration duration (Go duration: 24h, 1h, 30m)
DYNAGO_AUTH_TOKEN_TTL=24h

# Webhook URL called on every INSERT/UPDATE/DELETE (leave empty to disable)
DYNAGO_PG_HOOK_URL=

# -------------------------------------------------------------------
# Web UI & Explorer Features
# -------------------------------------------------------------------

# Flag 1: Enable Web UI mode (serves interactive dashboard at / and /ui with auto-generated endpoints & example JSON)
DYNAGO_ENABLE_UI=true

# Flag 2: Enable SQL query runner in UI mode (allows running raw SQL queries via the web console)
DYNAGO_ENABLE_SQL=true

# Flag 3: Enable Data View in UI mode (interactive table viewer with dynamic filters and pagination)
DYNAGO_ENABLE_DATA_VIEW=true

# Data View row limit (enforces safety limit and default pagination size)
DYNAGO_DATA_LIMIT=50
